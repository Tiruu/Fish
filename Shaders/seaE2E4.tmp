code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float ScaleUV = 1;
uniform bool PingPong;
uniform float SpeedModifier : hint_range(-2, 2) = 1;
uniform sampler2D tex_frg_12 : source_color;



void fragment() {
// Input:5
	vec2 n_out5p0 = UV;


// FloatParameter:6
	float n_out6p0 = ScaleUV;


// VectorOp:9
	vec2 n_out9p0 = n_out5p0 * vec2(n_out6p0);


// BooleanParameter:4
	bool n_out4p0 = PingPong;


// Input:2
	float n_out2p0 = TIME;


// FloatFunc:3
	float n_out3p0 = sin(n_out2p0);


	float n_out8p0;
// Switch:8
	n_out8p0 = mix(n_out2p0, n_out3p0, float(n_out4p0));


// FloatParameter:7
	float n_out7p0 = SpeedModifier;


// FloatOp:10
	float n_out10p0 = n_out8p0 * n_out7p0;


// VectorOp:11
	vec2 n_out11p0 = n_out9p0 + vec2(n_out10p0);


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, n_out11p0);


// Output:0
	ALBEDO = vec3(n_out12p0.xyz);


}
